# CrediFi — Preprod deployment environment (template)
#
# Copy this file to `.env.preprod`, fill in YOUR OWN credentials, and keep
# `.env.preprod` OUT of git (it is already git-ignored). NEVER commit it.
#
# Set exactly ONE of:
#   MIDNIGHT_PREPROD_SEED     -- 64 hex characters (32 bytes), no 0x prefix, OR
#   MIDNIGHT_PREPROD_MNEMONIC -- 24-word BIP-39 phrase (space separated)
# Setting both is an error.
#
# The wallet behind this credential must be FUNDED on Preprod (request tNIGHT
# from https://midnight-tmnight-preprod.nethermind.dev/ with its unshielded
# address) and registered for DUST generation, otherwise deployment fails with
# Wallet.InsufficientFunds.
#
#MIDNIGHT_PREPROD_SEED=
#MIDNIGHT_PREPROD_MNEMONIC=

# Password encrypting the private-state store. Must be >= 16 chars and include
# >= 3 of: uppercase, lowercase, digits, special characters.
PRIVATE_STATE_PASSWORD=

# Deployment is a REAL on-chain submission that costs DUST. It only runs when
# this is exactly "true". Leave it unset (or "false") for a safe preflight.
#DEPLOY_CONFIRM=true
