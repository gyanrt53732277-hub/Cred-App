# ============================================================
# CrediFi | Midnight Preprod Configuration
# ============================================================
#
# DEVELOPMENT TEMPLATE ONLY
#
# 1. Duplicate this file as: .env.preprod
# 2. Add your own wallet credentials and configuration values.
# 3. NEVER commit the populated .env.preprod file.
#
# Wallet authentication:
# Choose ONE authentication method:
#   - MIDNIGHT_PREPROD_SEED
#   - MIDNIGHT_PREPROD_MNEMONIC
#
# Do NOT configure both at the same time.
#
# Seed requirements:
#   • 64 hexadecimal characters
#   • Represents 32 bytes
#   • Do not include the "0x" prefix
#
# Mnemonic requirements:
#   • Valid BIP-39 recovery phrase
#   • 24 words separated by spaces
#
# ============================================================
# PREPROD WALLET
# ============================================================

# Option A — 32-byte hexadecimal wallet seed
# MIDNIGHT_PREPROD_SEED=

# Option B — 24-word BIP-39 wallet recovery phrase
# MIDNIGHT_PREPROD_MNEMONIC=


# ============================================================
# PRIVATE STATE SECURITY
# ============================================================
#
# Password used to protect the local private-state database.
#
# Requirements:
#   • Minimum length: 16 characters
#   • Must contain characters from at least 3 categories:
#       - Uppercase letters
#       - Lowercase letters
#       - Numbers
#       - Special characters
#

PRIVATE_STATE_PASSWORD=


# ============================================================
# BLOCKCHAIN DEPLOYMENT CONTROL
# ============================================================
#
# Deployment submits a real transaction to Midnight Preprod
# and consumes DUST.
#
# Safe/default behavior:
#   Leave DEPLOY_CONFIRM empty or set it to "false".
#
# To explicitly authorize deployment:
#   DEPLOY_CONFIRM=true
#
# ============================================================

# DEPLOY_CONFIRM=true


# ============================================================
# PREPROD WALLET REQUIREMENTS
# ============================================================
#
# Before deploying, make sure the configured wallet:
#
#   1. Exists on Midnight Preprod
#   2. Has sufficient tNIGHT
#   3. Has an unshielded address available
#   4. Is registered for DUST generation
#
# Without sufficient funds/DUST, deployment may fail with:
#
#   Wallet.InsufficientFunds
#
# ============================================================
